{
  "command_timeout": 5,
  "templates_folder": "",
  "templates_pairs": [["", ""]],
  "trigger_on_file_creation": true,
  "auto_jump_to_cursor": false,
  "enable_system_commands": false,
  "shell_path": "",
  "user_scripts_folder": "",
  "enable_folder_templates": false,
  "folder_templates": [{"folder": "", "template": ""}],
  "enable_file_templates": true,
  "file_templates": [
    {"regex": "(January|February|March|April|May|June|July|August|September|October|November|December) \\d{1,2}(st|nd|rd|th), \\d{4}\\.md$", "template": "time/daily/template.md"},
    {"regex": "Week \\d+, \\d{4}\\.md$", "template": "time/weekly/template.md"},
    {"regex": "(January|February|March|April|May|June|July|August|September|October|November|December), \\d{4}\\.md$", "template": "time/monthly/template.md"},
    {"regex": "Q[1-4], \\d{4}\\.md$", "template": "time/quarterly/template.md"},
    {"regex": "(^|/)\\d{4}\\.md$", "template": "time/yearly/template.md"}
  ],
  "syntax_highlighting": true,
  "syntax_highlighting_mobile": false,
  "enabled_templates_hotkeys": [""],
  "startup_templates": [""],
  "intellisense_render": 1,
  "ignore_folders_on_creation": []
}
